# Backend server
PORT=5000
NODE_ENV=development

# Use a local MongoDB instance, or replace with your team's Atlas URI.
MONGODB_URI=mongodb://localhost:27017/resume_db

# Replace with a long random value. Obtain the team value from a project lead if needed.
JWT_SECRET=replace-with-a-long-random-secret

# Maximum PDF upload size in MB.
UPLOAD_LIMIT=10

# Optional: enable AI-powered resume parsing with your own key.
# GEMINI_API_KEY=your-gemini-api-key

# Optional: enable vector search with a Voyage AI key.
# VOYAGE_API_KEY=your-voyage-api-key
# VOYAGE_MODEL=voyage-3
